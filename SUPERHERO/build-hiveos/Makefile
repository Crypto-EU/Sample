	$(MAKE) $(MAKESILENT) -f CMakeFiles/superhero.dir/build.make CMakeFiles/superhero.dir/src/util/hex.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/superhero-test.dir/build.make CMakeFiles/superhero-test.dir/src/util/hex.cpp.s
.PHONY : src/util/hex.cpp.s

